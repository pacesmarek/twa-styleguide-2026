---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/styleguide.css';

const codeCard = `<div class="card">Card content</div>`;

const codeButton = `<button class="btn btn-primary">Button</button>`;

const codeInput = `
<div class="form-field">
  <label for="input">Label</label>
  <input type="text" id="input" placeholder="Placeholder" />
</div>`;

const codeInputPassword = `
<div class="form-field">
  <label for="password">Password</label>
  <input type="password" id="password" placeholder="••••••••" />
</div>`;
---
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Style Guide</title>
  </head>
  <body>
    <h1>Style Guide</h1>

    <h2>Pages</h2>
    <ul>
      <li><a href="/twa-styleguide-2026/login">Login</a></li>
    </ul>

    <h2>Components</h2>

    <div class="component-item">
      <h3>Card</h3>
      <div class="component-preview">
        <div class="card">Card content</div>
      </div>
      <pre><code set:text={codeCard} /></pre>
    </div>

    <div class="component-item">
      <h3>Button</h3>
      <div class="component-preview">
        <button class="btn btn-primary">Button</button>
      </div>
      <pre><code set:text={codeButton} /></pre>
    </div>

    <div class="component-item">
      <h3>Input</h3>
      <div class="component-preview">
        <div class="form-field">
          <label for="sg-input">Label</label>
          <input type="text" id="sg-input" placeholder="Placeholder" />
        </div>
      </div>
      <pre><code set:text={codeInput} /></pre>
    </div>

    <div class="component-item">
      <h3>Input — password</h3>
      <div class="component-preview">
        <div class="form-field">
          <label for="sg-password">Password</label>
          <input type="password" id="sg-password" placeholder="••••••••" />
        </div>
      </div>
      <pre><code set:text={codeInputPassword} /></pre>
    </div>
  </body>
</html>
